# grice reports source spans as byte offsets, and its tests embed both source
# text and those offsets. A CRLF checkout (e.g. Windows with
# core.autocrlf=true) adds a byte per line, shifting every span so the tests
# fail with no semantic change. Force LF in the working tree for all text
# files.
* text=auto eol=lf

# Sources whose byte offsets grice reports, pinned explicitly so the intent
# survives even if the blanket rule above is ever relaxed.
*.gleam text eol=lf
